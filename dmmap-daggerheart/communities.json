  }, {
    "id" : "orderborne",
    "name" : "Orderborne",
    "text" : "Being part of an orderborne community means you’re from a collective that focuses on discipline or faith, and you uphold a set of principles that reflect your experience there.",
    "features" : [ {
      "name" : "Dedicated",
      "text" : "Record three sayings or values your upbringing instilled in you. Once per rest, when you describe how you’re embodying one of these principles through your current action, you can roll a d20 as your Hope Die.",
      "automation" : {
        "limits" : {
          "uses" : {
            "max" : 1,
            "resetOn" : [ "rest.short", "rest.long" ]
          }
        },
        "rules" : [ {
          "id" : "use",
          "bindings" : [ {
            "id" : "sheet",
            "event" : "action.request",
            "surface" : "sheet",
            "mode" : "button"
          } ],
          "limitRef" : "uses",
          "ui" : {
            "label" : "Dedicated"
          }
        }, {
          "id" : "hope-die",
          "bindings" : [ {
            "id" : "use",
            "event" : "roll.prepare",
            "surface" : "roll",
            "mode" : "option"
