            },
            "as" : "hopeDice"
          }, {
            "op" : "roll.resize",
            "from" : {
              "read" : "event.roll"
            },
            "dice" : {
              "read" : "result.hopeDice"
            },
            "sides" : 20,
            "as" : "hopeResized"
