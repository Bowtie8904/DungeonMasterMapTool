{
  "format" : "dmmap-daggerheart",
  "version" : 2,
  "category" : "communities",
  "label" : "Communities",
  "entries" : [ {
    "id" : "duneborne",
    "name" : "Duneborne",
    "text" : "Being part of a duneborne community means you’ve made a home among the shifting sands and arid climate of the desert.",
    "features" : [ {
      "name" : "Oasis",
      "text" : "During a short rest, you or an ally can reroll a die used for a downtime move and take the higher result.",
      "automation" : {
        "limits" : {
          "uses" : {
            "max" : 1,
            "resetOn" : [ "rest.short", "rest.long" ]
          }
        },
        "rules" : [ {
          "id" : "rest-reroll",
          "bindings" : [ {
            "id" : "use",
            "event" : "rest.roll",
            "surface" : "chat",
            "mode" : "button"
          } ],
          "limitRef" : "uses",
          "do" : [ {
            "op" : "roll.keptDice",
            "role" : "downtime",
            "as" : "dice",
            "from" : {
              "read" : "event.roll"
            }
          }, {
            "op" : "roll.reroll",
            "choose" : "higherTotal",
            "as" : "rerolled",
            "from" : {
              "read" : "event.roll"
            },
            "dice" : {
              "read" : "result.dice"
            }
          }, {
            "op" : "roll.publish",
            "roll" : {
              "read" : "result.rerolled"
            }
          } ],
          "ui" : {
            "label" : "Reroll downtime die",
            "report" : "{actor.name} rerolled the downtime die and kept {result.rerolled.total}."
          }
        } ]
      },
      "id" : "oasis",
      "_catalogFeatureId" : "cf604894-e8a7-3fb2-871c-be118c6bf1f7"
    } ]
  }, {
    "id" : "freeborne",
    "name" : "Freeborne",
    "text" : "Being part of a freeborne community means you’re from a collective that once lived under tyrannical rule but is now liberated.",
    "features" : [ {
      "name" : "Unbound",
      "text" : "Once per session when you roll with **Fear**, you can change it into a roll with Hope instead.",
      "automation" : {
        "limits" : {
          "uses" : {
            "max" : 1,
            "resetOn" : [ "session.start" ]
          }
        },
        "rules" : [ {
          "id" : "use",
          "bindings" : [ {
            "id" : "sheet",
            "event" : "action.request",
            "surface" : "sheet",
            "mode" : "button"
          } ],
          "limitRef" : "uses",
          "ui" : {
            "label" : "Unbound"
          }
        }, {
          "id" : "hope",
          "bindings" : [ {
            "id" : "use",
            "event" : "roll.finished",
            "surface" : "roll",
            "mode" : "button"
          } ],
          "ui" : {
            "label" : "Unbound: change Fear into Hope",
            "description" : "The GM does not gain Fear."
          },
          "when" : {
            "and" : [ {
              "or" : [ {
                "and" : [ {
                  "exists" : "event.check.duality"
                }, {
                  "eq" : [ {
                    "read" : "event.check.duality"
                  }, true ]
                } ]
              }, {
                "and" : [ {
                  "exists" : "event.check.dominant"
                }, {
                  "ne" : [ {
                    "read" : "event.check.dominant"
                  }, null ]
                } ]
              } ]
            }, {
              "eq" : [ {
                "read" : "event.check.dominant"
              }, "fear" ]
            }, {
              "ne" : [ {
                "read" : "event.check.critical"
              }, true ]
            }, {
              "ne" : [ {
                "read" : "event.check.dominant"
              }, "hope" ]
            }, {
              "ne" : [ {
                "read" : "event.check.critical"
              }, true ]
            } ]
          },
          "limitRef" : "uses"
        } ]
      },
      "id" : "unbound",
      "_catalogFeatureId" : "971023ce-ae27-3e5e-92e4-804496e995d8"
    } ]
  }, {
    "id" : "frostborne",
    "name" : "Frostborne",
    "text" : "Being part of a frostborne community means you come from a place of snow and ice.",
    "features" : [ {
      "name" : "Hardy",
      "text" : "When you take a rest, you clear a Hit Point.",
      "automation" : {
        "rules" : [ {
          "id" : "recovery",
          "bindings" : [ {
            "id" : "rest-short",
            "event" : "rest.short",
            "surface" : "rest",
            "mode" : "option",
            "defaultOn" : true
          }, {
            "id" : "rest-long",
            "event" : "rest.long",
            "surface" : "rest",
            "mode" : "option",
            "defaultOn" : true
          } ],
          "ui" : {
            "label" : "clear 1 HP"
          },
          "do" : [ {
            "op" : "track.clear",
            "track" : "actor.hp",
            "amount" : 1
          } ]
        } ]
      },
      "id" : "hardy",
      "_catalogFeatureId" : "bb7534dd-d0ba-3c36-a0a4-ded69f77070a"
    } ]
  }, {
    "id" : "hearthborne",
    "name" : "Hearthborne",
    "text" : "Being part of a hearthborne community means you come from humble origins, having lived in a modest village or quaint countryside.",
    "features" : [ {
      "name" : "Close-Knit",
      "text" : "Once per long rest, you can **spend any number of Hope** to grant an ally within Far range an equal number of Hope.",
      "automation" : {
        "limits" : {
          "uses" : {
            "max" : 1,
            "resetOn" : [ "rest.long" ]
          }
        },
        "rules" : [ {
          "id" : "use",
          "bindings" : [ {
            "id" : "sheet",
            "event" : "action.request",
            "surface" : "sheet",
            "mode" : "button",
            "targetSelection" : {
              "cardinality" : "one",
              "scope" : "connectedPlayerCharacters",
              "excludeSource" : true
            }
          } ],
          "inputs" : [ {
            "id" : "amount",
            "kind" : "integer",
            "label" : "Hope to give",
            "min" : 1,
            "max" : {
              "read" : "actor.hope.value"
            }
          } ],
          "when" : {
            "gte" : [ {
              "read" : "actor.hope.value"
            }, 1 ]
          },
          "costs" : [ {
            "op" : "resource.spend",
            "pool" : "actor.hope",
            "amount" : {
              "read" : "input.amount"
            }
          } ],
          "limitRef" : "uses",
          "do" : [ {
            "op" : "resource.gain",
            "pool" : "recipient.hope",
            "amount" : {
              "read" : "input.amount"
            }
          } ],
          "ui" : {
            "label" : "Close-Knit",
            "report" : "Gave {input.amount} Hope to {recipient.name}."
          }
        } ]
      },
      "id" : "close-knit",
      "_catalogFeatureId" : "9d7d5ba1-9d9c-36de-b0fc-3e4e6e0c113c"
    } ]
  }, {
    "id" : "highborne",
    "name" : "Highborne",
    "text" : "Being part of a highborne community means you’re accustomed to a life of elegance, opulence, and prestige within the upper echelons of society.",
    "features" : [ {
      "name" : "Privilege",
      "text" : "You have advantage on rolls to consort with nobles, negotiate prices, or leverage your reputation to get what you want.",
      "automation" : {
        "rules" : [ {
          "id" : "advantage",
          "bindings" : [ {
            "id" : "use",
            "event" : "roll.prepare",
            "surface" : "roll",
            "mode" : "option"
          } ],
          "ui" : {
            "label" : "Privilege",
            "description" : "You have advantage on rolls to consort with nobles, negotiate prices, or leverage your reputation to get what you want."
          },
          "when" : {
            "and" : [ {
              "or" : [ {
                "eq" : [ {
                  "read" : "event.check.kind"
                }, "action" ]
              }, {
                "eq" : [ {
                  "read" : "event.check.kind"
                }, "attack" ]
              }, {
                "eq" : [ {
                  "read" : "event.check.kind"
                }, "spellcast" ]
              } ]
            }, {
              "ne" : [ {
                "read" : "event.check.kind"
              }, "attack" ]
            } ]
          },
          "do" : [ {
            "op" : "roll.annotate",
            "from" : {
              "read" : "event.roll"
            },
            "field" : "advantageSuggested",
            "value" : true,
            "as" : "suggested"
          }, {
            "op" : "roll.publish",
            "roll" : {
              "read" : "result.suggested"
            }
          } ]
        } ]
      },
      "id" : "privilege",
      "_catalogFeatureId" : "be0bca2b-dd5c-3a0f-a58c-6b4c5c27d48d"
    } ]
  }, {
