            "or" : [ {
              "eq" : [ {
                "read" : "event.check.kind"
              }, "action" ]
            }, {
              "eq" : [ {
                "read" : "event.check.kind"
              }, "attack" ]
            }, {
              "eq" : [ {
                "read" : "event.check.kind"
