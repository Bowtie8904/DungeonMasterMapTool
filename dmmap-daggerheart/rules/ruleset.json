{
  "format": "dmmap-daggerheart-ruleset",
  "version": 2,
  "name": "Daggerheart rules",
  "rest": {
    "startFacts": { "hitPoints": "hp.marked", "stress": "stress.marked",
      "armor": "armorTrack.marked", "hope": "hope.value" },
    "short": { "moves": 2, "maxMoves": 32, "maxLongMoves": 1, "consecutiveLimit": 3 },
    "long": { "moves": 2, "maxMoves": 32 }
  },
  "automation": {
    "rules": [
      {
        "id": "manual-roll-mode",
        "bindings": [{ "id": "use", "event": "roll.prepare", "surface": "roll", "mode": "option" }],
        "when": { "eq": [{ "read": "event.check.duality" }, true] },
        "inputs": [{ "id": "mode", "kind": "choice", "label": "Roll mode", "options": [
          { "id": "normal", "label": "Normal" },
          { "id": "advantage", "label": "Advantage (+d6)" },
          { "id": "disadvantage", "label": "Disadvantage (-d6)" }
        ] }],
        "do": [
          { "op": "roll.annotate", "from": { "read": "event.roll" }, "field": "modeChoice",
            "value": { "read": "input.mode" }, "as": "chosen" },
          { "op": "roll.publish", "roll": { "read": "result.chosen" } }
        ],
        "ui": { "label": "Override roll mode", "description": "Choose a mode instead of the selected options' suggestions." }
      },
      {
        "id": "resolve-roll-mode",
        "bindings": [{ "id": "resolve", "event": "roll.prepared", "surface": "roll",
          "mode": "automatic", "priority": 1000 }],
        "when": { "eq": [{ "read": "event.check.duality" }, true] },
        "do": [
          { "op": "value", "as": "advantage", "value": { "or": [
            { "and": [
              { "exists": "event.roll.metadata.advantageSuggested" },
              { "eq": [{ "read": "event.roll.metadata.advantageSuggested" }, true] }
            ] },
            { "includes": [{ "pluck": [{ "read": "event.roll.contributions" }, "role"] }, "advantage"] }
          ] } },
          { "op": "value", "as": "disadvantage", "value": { "or": [
            { "and": [
              { "exists": "event.roll.metadata.disadvantageSuggested" },
              { "eq": [{ "read": "event.roll.metadata.disadvantageSuggested" }, true] }
            ] },
            { "includes": [{ "pluck": [{ "read": "event.roll.contributions" }, "role"] }, "disadvantage"] }
          ] } },
          { "op": "value", "as": "mode", "value": { "if": [
            { "exists": "event.roll.metadata.modeChoice" }, { "read": "event.roll.metadata.modeChoice" },
            { "if": [
              { "eq": [{ "read": "result.advantage" }, { "read": "result.disadvantage" }] }, "normal",
              { "if": [{ "read": "result.advantage" }, "advantage", "disadvantage"] }
            ] }
          ] } },
          { "op": "value", "as": "ignored", "value": { "and": [
            { "eq": [{ "read": "result.mode" }, "disadvantage"] },
            { "exists": "event.roll.metadata.ignoreDisadvantage" },
            { "eq": [{ "read": "event.roll.metadata.ignoreDisadvantage" }, true] }
          ] } },
          { "op": "roll.discard", "from": { "read": "event.roll" }, "role": "advantage", "as": "withoutAdvantage" },
          { "op": "roll.discard", "from": { "read": "result.withoutAdvantage" }, "role": "disadvantage", "as": "base" },
          { "op": "roll.contribute", "from": { "read": "result.base" }, "beforeScales": true, "as": "withAdvantage",
            "contribution": { "id": "core.advantage", "kind": "dice", "role": "advantage",
              "label": "Advantage", "count": { "if": [{ "eq": [{ "read": "result.mode" }, "advantage"] }, 1, 0] }, "sides": 6 } },
          { "op": "roll.contribute", "from": { "read": "result.withAdvantage" }, "beforeScales": true, "as": "withDisadvantage",
            "contribution": { "id": "core.disadvantage", "kind": "dice", "role": "disadvantage",
              "label": "Disadvantage", "count": { "if": [
                { "and": [{ "eq": [{ "read": "result.mode" }, "disadvantage"] }, { "not": { "read": "result.ignored" } }] }, 1, 0
              ] }, "sides": 6, "sign": -1 } },
          { "op": "roll.publish", "roll": { "read": "result.withDisadvantage" } }
        ],
        "ui": {}
      },
      {
        "id": "experience",
        "bindings": [{ "id": "use", "event": "roll.prepare", "surface": "roll", "mode": "option" }],
        "when": { "and": [
          { "eq": [{ "read": "event.check.duality" }, true] },
          { "gt": [{ "size": { "read": "actor.experiences" } }, 0] }
        ] },
        "inputs": [{
          "id": "experience", "kind": "record.select", "label": "Choose an Experience",
          "from": { "read": "actor.experiences" },
          "choiceLabel": "{input.option.name} ({input.option.mod|signed})"
        }],
        "costs": [{ "op": "resource.spend", "pool": "actor.hope", "amount": 1 }],
        "do": [
          { "op": "roll.contribute", "from": { "read": "event.roll" }, "as": "withExperience",
            "contribution": { "id": "experience", "kind": "flat", "role": "modifier",
              "label": "Experience - {input.experience.name}", "value": { "read": "input.experience.mod" } } },
          { "op": "roll.publish", "roll": { "read": "result.withExperience" } }
        ],
        "ui": { "label": "Use an Experience", "description": "Spend 1 Hope to add an Experience." }
      },
      {
        "id": "rest-tend",
        "bindings": [{
          "id": "move", "event": "downtime.move", "surface": "downtime", "mode": "button",
          "restMove": { "id": "tend", "kind": "short" }
        }],
        "do": [
          { "op": "dice.roll", "count": 1, "sides": 4, "as": "roll" },
          { "op": "track.clear", "track": "actor.hp", "amount": { "max": [0, { "add": [
            { "read": "result.roll" }, { "read": "actor.stats.tier" }, { "read": "event.move.bonus" }
          ] }] }, "as": "cleared" },
          { "op": "recovery.offerRoll", "roll": { "read": "result.roll" }, "track": "actor.hp", "label": "Tend to Wounds" }
        ],
        "ui": { "label": "Tend to Wounds", "report": "{actor.name} cleared {result.cleared} HP (1d4: {result.roll}, tier: {actor.stats.tier})." }
      },
      {
        "id": "rest-tend-ally",
        "bindings": [{
          "id": "move", "event": "downtime.move", "surface": "downtime", "mode": "button",
          "restMove": { "id": "tend", "kind": "short", "ally": true },
          "targetSelection": { "cardinality": "one", "scope": "activeCharacters", "excludeSource": true }
        }],
        "do": [
          { "op": "dice.roll", "count": 1, "sides": 4, "as": "roll" },
          { "op": "track.clear", "track": "recipient.hp", "amount": { "max": [0, { "add": [
            { "read": "result.roll" }, { "read": "actor.stats.tier" }, { "read": "event.move.bonus" }
          ] }] }, "as": "cleared" },
          { "op": "recovery.offerRoll", "roll": { "read": "result.roll" }, "track": "recipient.hp", "label": "Tend to Wounds" }
        ],
        "ui": { "label": "Tend to Wounds (an ally)", "report": "{actor.name} cleared {result.cleared} HP for {recipient.name} (1d4: {result.roll}, tier: {actor.stats.tier})." }
      },
      {
        "id": "rest-stress",
        "bindings": [{
          "id": "move", "event": "downtime.move", "surface": "downtime", "mode": "button",
          "restMove": { "id": "stress", "kind": "short" }
        }],
        "do": [
          { "op": "dice.roll", "count": 1, "sides": 4, "as": "roll" },
          { "op": "track.clear", "track": "actor.stress", "amount": { "max": [0, { "add": [
            { "read": "result.roll" }, { "read": "actor.stats.tier" }, { "read": "event.move.bonus" }
          ] }] }, "as": "cleared" },
          { "op": "recovery.offerRoll", "roll": { "read": "result.roll" }, "track": "actor.stress", "label": "Clear Stress" }
        ],
        "ui": { "label": "Clear Stress", "report": "{actor.name} cleared {result.cleared} Stress (1d4: {result.roll}, tier: {actor.stats.tier})." }
      },
      {
        "id": "rest-repair",
        "bindings": [{
          "id": "move", "event": "downtime.move", "surface": "downtime", "mode": "button",
          "restMove": { "id": "repair", "kind": "short" }
        }],
        "do": [
          { "op": "dice.roll", "count": 1, "sides": 4, "as": "roll" },
          { "op": "track.clear", "track": "actor.armorTrack", "amount": { "max": [0, { "add": [
            { "read": "result.roll" }, { "read": "actor.stats.tier" }, { "read": "event.move.bonus" }
          ] }] }, "as": "cleared" },
          { "op": "recovery.offerRoll", "roll": { "read": "result.roll" }, "track": "actor.armorTrack", "label": "Repair Armor" }
        ],
        "ui": { "label": "Repair Armor", "report": "{actor.name} repaired {result.cleared} Armor Slots (1d4: {result.roll}, tier: {actor.stats.tier})." }
      },
      {
        "id": "rest-repair-ally",
        "bindings": [{
          "id": "move", "event": "downtime.move", "surface": "downtime", "mode": "button",
          "restMove": { "id": "repair", "kind": "short", "ally": true },
          "targetSelection": { "cardinality": "one", "scope": "activeCharacters", "excludeSource": true }
        }],
        "do": [
          { "op": "dice.roll", "count": 1, "sides": 4, "as": "roll" },
          { "op": "track.clear", "track": "recipient.armorTrack", "amount": { "max": [0, { "add": [
            { "read": "result.roll" }, { "read": "actor.stats.tier" }, { "read": "event.move.bonus" }
          ] }] }, "as": "cleared" },
          { "op": "recovery.offerRoll", "roll": { "read": "result.roll" }, "track": "recipient.armorTrack", "label": "Repair Armor" }
        ],
        "ui": { "label": "Repair Armor (an ally)", "report": "{actor.name} repaired {result.cleared} Armor Slots for {recipient.name} (1d4: {result.roll}, tier: {actor.stats.tier})." }
      },
      {
        "id": "rest-prepare",
        "bindings": [{
          "id": "move", "event": "downtime.move", "surface": "downtime", "mode": "button",
          "restMove": { "id": "prepare", "kind": "any", "group": "prepare" }
        }],
        "do": [{ "op": "resource.gain", "pool": "actor.hope", "amount": 1, "as": "hope" }],
        "ui": { "label": "Prepare (alone)", "report": "{actor.name} gained {result.hope} Hope." }
      },
      {
        "id": "rest-prepare-group",
        "bindings": [{
          "id": "move", "event": "downtime.move", "surface": "downtime", "mode": "button",
          "restMove": { "id": "prepare-group", "kind": "any", "group": "prepare" }
        }],
        "do": [{ "op": "resource.gain", "pool": "actor.hope", "amount": 2, "as": "hope" }],
        "ui": { "label": "Prepare (with others)", "report": "{actor.name} gained {result.hope} Hope." }
      },
      {
        "id": "rest-tend-all",
        "bindings": [{
          "id": "move", "event": "downtime.move", "surface": "downtime", "mode": "button",
          "restMove": { "id": "tend-all", "kind": "longMove" }
        }],
        "do": [{ "op": "track.clear", "track": "actor.hp", "amount": { "read": "actor.hp.marked" }, "as": "cleared" }],
        "ui": { "label": "Tend to All Wounds", "report": "{actor.name} cleared {result.cleared} HP." }
      },
      {
        "id": "rest-tend-all-ally",
        "bindings": [{
          "id": "move", "event": "downtime.move", "surface": "downtime", "mode": "button",
          "restMove": { "id": "tend-all", "kind": "longMove", "ally": true },
          "targetSelection": { "cardinality": "one", "scope": "activeCharacters", "excludeSource": true }
        }],
        "do": [{ "op": "track.clear", "track": "recipient.hp", "amount": { "read": "recipient.hp.marked" }, "as": "cleared" }],
        "ui": { "label": "Tend to All Wounds (an ally)", "report": "{actor.name} cleared {result.cleared} HP for {recipient.name}." }
      },
      {
        "id": "rest-stress-all",
        "bindings": [{
          "id": "move", "event": "downtime.move", "surface": "downtime", "mode": "button",
          "restMove": { "id": "stress-all", "kind": "longMove" }
        }],
        "do": [{ "op": "track.clear", "track": "actor.stress", "amount": { "read": "actor.stress.marked" }, "as": "cleared" }],
        "ui": { "label": "Clear All Stress", "report": "{actor.name} cleared {result.cleared} Stress." }
      },
      {
        "id": "rest-repair-all",
        "bindings": [{
          "id": "move", "event": "downtime.move", "surface": "downtime", "mode": "button",
          "restMove": { "id": "repair-all", "kind": "longMove" }
        }],
        "do": [{ "op": "track.clear", "track": "actor.armorTrack", "amount": { "read": "actor.armorTrack.marked" }, "as": "cleared" }],
        "ui": { "label": "Repair All Armor", "report": "{actor.name} repaired {result.cleared} Armor Slots." }
      },
      {
        "id": "rest-repair-all-ally",
        "bindings": [{
          "id": "move", "event": "downtime.move", "surface": "downtime", "mode": "button",
          "restMove": { "id": "repair-all", "kind": "longMove", "ally": true },
          "targetSelection": { "cardinality": "one", "scope": "activeCharacters", "excludeSource": true }
        }],
        "do": [{ "op": "track.clear", "track": "recipient.armorTrack", "amount": { "read": "recipient.armorTrack.marked" }, "as": "cleared" }],
        "ui": { "label": "Repair All Armor (an ally)", "report": "{actor.name} repaired {result.cleared} Armor Slots for {recipient.name}." }
      },
      {
        "id": "rest-project",
        "bindings": [{
          "id": "move", "event": "downtime.move", "surface": "downtime", "mode": "button",
          "restMove": { "id": "project", "kind": "longMove" }
        }],
        "ui": { "label": "Work on a Project", "report": "{actor.name} worked on a project." }
      },
      {
        "id": "hope-reward",
        "bindings": [{
          "id": "claim",
          "event": "roll.finished",
          "surface": "roll",
          "mode": "button",
          "audience": "self",
          "claimGroup": "roll-reward",
          "claimGroupScope": "result",
          "claimScope": { "recipients": "sourceActor" }
        }],
        "when": { "and": [
          { "eq": [{ "read": "event.check.duality" }, true] },
          { "ne": [{ "read": "event.check.kind" }, "reaction"] },
          { "ne": [{ "read": "event.check.kind" }, "death"] },
          { "eq": [{ "read": "event.check.dominant" }, "hope"] },
          { "eq": [{ "read": "event.check.critical" }, false] },
          { "lt": [{ "read": "actor.hope.value" }, { "read": "actor.hope.max" }] }
        ] },
        "do": [
          { "op": "resource.gain", "pool": "actor.hope", "amount": 1, "as": "hope" }
        ],
        "ui": {
          "label": "Gain 1 Hope",
          "report": "{actor.name} gained {result.hope} Hope."
        }
      },
      {
        "id": "critical-reward",
        "bindings": [{
          "id": "claim",
          "event": "roll.finished",
          "surface": "roll",
          "mode": "button",
          "audience": "self",
          "claimGroup": "roll-reward",
          "claimGroupScope": "result",
          "claimScope": { "recipients": "sourceActor" }
        }],
        "when": { "and": [
          { "eq": [{ "read": "event.check.duality" }, true] },
          { "ne": [{ "read": "event.check.kind" }, "reaction"] },
          { "ne": [{ "read": "event.check.kind" }, "death"] },
          { "eq": [{ "read": "event.check.critical" }, true] },
          { "or": [
            { "lt": [{ "read": "actor.hope.value" }, { "read": "actor.hope.max" }] },
            { "gt": [{ "read": "actor.stress.marked" }, 0] }
          ] }
        ] },
        "do": [
          { "op": "resource.gain", "pool": "actor.hope", "amount": 1, "as": "hope" },
          { "op": "track.clear", "track": "actor.stress", "amount": 1, "as": "stress" }
        ],
        "ui": {
          "label": "Gain Hope and clear Stress",
          "report": "{actor.name} gained {result.hope} Hope and cleared {result.stress} Stress."
        }
      }
    ]
  }
}
