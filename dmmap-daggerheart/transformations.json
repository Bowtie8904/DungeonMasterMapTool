    "id" : "demigod",
    "name" : "Demigod",
    "text" : "Demigods are mortal creatures whose veins flow with the blood of the gods.",
    "features" : [ {
      "name" : "Gifted",
      "text" : "You gain a +1 bonus to action, reaction, and damage rolls.",
      "automation" : {
        "modifiers" : [ {
          "stat" : "roll.action",
          "value" : 1
        }, {
          "stat" : "roll.reaction",
          "value" : 1
        }, {
          "stat" : "roll.damage",
          "value" : 1
        } ]
      },
      "id" : "gifted",
      "_catalogFeatureId" : "4e4e98f9-4d27-303f-877e-7847c2f6b4f1"
    }, {
      "name" : "Weight of Divinity",
      "text" : "When you fail a roll, you must mark a Stress or the GM gains a Fear.",
      "_catalogFeatureId" : "ebd3fd82-dd14-3889-b192-e44198b3d6d8"
    } ]
  }, {
    "id" : "ghost",
    "name" : "Ghost",
    "text" : "Ghosts are the spirits of the once-living who are bound to the Mortal Realm.",
    "features" : [ {
      "name" : "Unfinished Business",
      "text" : "Work with your GM to decide what purpose or desire keeps you bound to the Mortal Realm. When you fulfill it, you cross through the veil of death.",
      "_catalogFeatureId" : "baaee59a-13fd-3ec3-9ca7-18a02da8ee4c"
    }, {
      "name" : "Ephemeral",
      "text" : "Your body wavers in and out of being corporeal. You are resistant to physical damage, take double magic damage, and can **mark 2 Stress** to momentarily pass through a solid object.",
      "automation" : {
        "rules" : [ {
          "id" : "pass-through",
          "bindings" : [ {
            "id" : "sheet",
            "event" : "action.request",
            "surface" : "sheet",
            "mode" : "button"
          } ],
          "costs" : [ {
            "op" : "track.mark",
            "track" : "actor.stress",
            "amount" : 2
          } ],
          "ui" : {
            "label" : "Pass through a solid object"
          }
        }, {
          "id" : "physical-resistance",
          "bindings" : [ {
            "id" : "use",
            "event" : "damage.prepare",
            "surface" : "damage",
            "mode" : "automatic"
          } ],
          "ui" : {
            "label" : "Ephemeral physical resistance"
          },
          "when" : {
            "and" : [ {
              "gt" : [ {
                "read" : "event.damage.amount"
              }, 0 ]
            }, {
              "eq" : [ {
                "read" : "event.damageType"
              }, "physical" ]
            } ]
          },
          "do" : [ {
            "op" : "damage.reduce",
            "from" : {
              "read" : "event.damage"
            },
            "amount" : {
              "floor" : {
                "divide" : [ {
                  "read" : "event.damage.amount"
                }, 2 ]
              }
            },
            "id" : "physical-resistance",
            "label" : "Ephemeral physical resistance",
            "as" : "reduced"
          }, {
            "op" : "damage.publish",
            "damage" : {
              "read" : "result.reduced.damage"
            }
          } ]
        }, {
          "id" : "magic-vulnerability",
          "bindings" : [ {
            "id" : "use",
            "event" : "damage.prepare",
            "surface" : "damage",
            "mode" : "automatic"
          } ],
          "ui" : {
            "label" : "Ephemeral double magic damage"
          },
          "when" : {
            "and" : [ {
              "gt" : [ {
                "read" : "event.damage.amount"
              }, 0 ]
            }, {
              "eq" : [ {
                "read" : "event.damageType"
              }, "magic" ]
            } ]
          },
          "do" : [ {
            "op" : "damage.increase",
            "from" : {
              "read" : "event.damage"
            },
            "amount" : {
              "read" : "event.damage.amount"
            },
            "id" : "magic-vulnerability",
            "label" : "Ephemeral double magic damage",
            "as" : "reduced"
          }, {
            "op" : "damage.publish",
            "damage" : {
              "read" : "result.reduced.damage"
            }
          } ]
        } ]
      },
      "id" : "ephemeral",
      "_catalogFeatureId" : "1f557745-988e-37e8-85f2-2e1d3d687612"
    } ]
  }, {
    "id" : "reanimated",
    "name" : "Reanimated",
    "text" : "Reanimated are corpses who have been brought back to life.",
    "features" : [ {
      "name" : "Corpse",
      "text" : "During a rest, you can clear Hit Points only if you have access to remains from a recently deceased creature. Describe how you use these materials to maintain your corpse.",
      "_catalogFeatureId" : "01bfbac4-e956-3774-b0e3-e8a0d215248c"
    }, {
      "name" : "Won’t Stay Dead",
      "text" : "When you choose the Risk It All death move and fail, you can **permanently mark a Hit Point** to succeed instead. When you do, you still use the Hope Die’s value to clear Hit Points and Stress. When you permanently mark your last Hit Point, you pass through the veil of death.",
      "automation" : {
        "rules" : [ {
          "id" : "undying",
          "bindings" : [ {
            "id" : "claim",
            "event" : "roll.finished",
            "surface" : "roll",
            "mode" : "button",
            "claimGroup" : "death-outcome",
            "audience" : "self",
            "claimScope" : {
              "recipients" : "sourceActor"
            }
          } ],
          "when" : {
            "and" : [ {
              "eq" : [ {
                "read" : "event.check.kind"
              }, "death" ]
            }, {
              "eq" : [ {
                "read" : "event.check.move"
              }, "risk" ]
            }, {
              "eq" : [ {
                "read" : "event.check.dominant"
              }, "fear" ]
            }, {
              "ne" : [ {
                "read" : "event.check.critical"
              }, true ]
            } ]
          },
          "do" : [ {
            "op" : "track.capacity",
            "track" : "actor.hp",
            "by" : -1,
            "as" : "hp"
          }, {
            "op" : "roll.annotate",
            "field" : "deathOutcome",
            "value" : "hope",
            "as" : "roll",
            "from" : {
              "read" : "event.roll"
            }
          }, {
            "op" : "roll.publish",
            "roll" : {
              "read" : "result.roll"
            }
          } ],
          "ui" : {
            "label" : "Mark a Hit Point permanently to succeed with Hope",
            "report" : "Permanently marked a Hit Point to succeed with Hope."
          }
        } ]
      },
      "id" : "won-t-stay-dead",
      "_catalogFeatureId" : "aa5e7b20-520d-3619-9311-e3a44c609952"
    } ]
