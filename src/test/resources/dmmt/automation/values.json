{
  "expressions": [
    { "name": "pluck labels", "expression": { "includes": [{ "pluck": [{ "read": "actor.effects" }, "label"] }, "Raging"] }, "context": { "actor": { "effects": [{ "id": "a", "label": "Raging" }, { "id": "b" }] } }, "expected": true },
    { "name": "pluck skips missing fields", "expression": { "pluck": [{ "read": "actor.effects" }, "label"] }, "context": { "actor": { "effects": [{ "id": "a" }, { "label": "Calm" }] } }, "expected": ["Calm"] },
    { "name": "pluck rejects non-collections", "expression": { "pluck": [3, "label"] }, "context": {}, "error": true },
    { "name": "exists present", "expression": { "exists": "event.check.weapon" }, "context": { "event": { "check": { "weapon": "primary" } } }, "expected": true },
    { "name": "exists absent", "expression": { "exists": "event.check.weapon" }, "context": { "event": { "check": {} } }, "expected": false },
    { "name": "derived arithmetic", "expression": { "add": [1, { "read": "actor.proficiency" }] }, "context": { "actor": { "proficiency": 3 } }, "expected": 4 },
    { "name": "negative floor", "expression": { "floor": { "divide": [-3, 2] } }, "context": {}, "expected": -2 },
    { "name": "negative ceiling", "expression": { "ceil": { "divide": [-3, 2] } }, "context": {}, "expected": -1 },
    { "name": "bounded gain", "expression": { "clamp": [10, 0, 6] }, "context": {}, "expected": 6 },
    { "name": "predicate", "expression": { "gte": [{ "size": { "read": "state.remaining" } }, 2] }, "context": { "state": { "remaining": ["a", "b"] } }, "expected": true },
    { "name": "short circuit", "expression": { "and": [false, { "read": "event.hidden" }] }, "context": {}, "expected": false },
    { "name": "choose only one branch", "expression": { "if": [true, 4, { "read": "event.hidden" }] }, "context": {}, "expected": 4 },
    { "name": "optional fact", "expression": { "exists": "event.difficulty" }, "context": { "event": {} }, "expected": false },
    { "name": "literal collection", "expression": { "includes": [{ "literal": ["a", "b"] }, "a"] }, "context": {}, "expected": true },
    { "name": "count equal elements", "expression": { "count": [{ "pluck": [{ "read": "actor.loadout" }, "domain"] }, "Valor"] }, "context": { "actor": { "loadout": [{ "domain": "Valor" }, { "domain": "Blade" }, { "domain": "Valor" }] } }, "expected": 2 },
    { "name": "count needs a collection", "expression": { "count": [3, 3] }, "context": {}, "error": true },
    { "name": "numeric equality", "expression": { "eq": [1.0, 1] }, "context": {}, "expected": true },
    { "name": "object equality independent of order", "expression": { "eq": [{ "literal": { "a": 1, "b": 2 } }, { "literal": { "b": 2.0, "a": 1 } }] }, "context": {}, "expected": true },
    { "name": "unavailable context", "expression": { "read": "event.hiddenDifficulty" }, "context": {}, "error": true },
    { "name": "no string coercion", "expression": { "add": [1, "2"] }, "context": {}, "error": true },
    { "name": "no truthiness coercion", "expression": { "and": [true, 1] }, "context": {}, "error": true },
    { "name": "unknown operation", "expression": { "deathrun": true }, "context": {}, "error": true },
    { "name": "no evaluation escape hatch", "expression": { "eval": "1 + 1" }, "context": {}, "error": true },
    { "name": "no prototype access", "expression": { "read": "actor.constructor.name" }, "context": {}, "error": true },
    { "name": "no unknown root", "expression": { "read": "campaign.secret" }, "context": {}, "error": true },
    { "name": "zero division", "expression": { "divide": [1, 0] }, "context": {}, "error": true },
    { "name": "overflow", "expression": { "add": [9007199254740991, 1] }, "context": {}, "error": true },
    { "name": "empty arithmetic", "expression": { "add": [] }, "context": {}, "error": true },
    { "name": "unknown trailing field", "expression": { "read": "actor.name", "fallback": "name" }, "context": {}, "error": true },
    { "name": "validate unreachable branch", "expression": { "if": [true, 1, { "eval": "2" }] }, "context": {}, "error": true },
    { "name": "clamp bounds", "expression": { "clamp": [2, 4, 1] }, "context": {}, "error": true },
    { "name": "object builds dynamic objects", "expression": { "object": { "id": { "read": "state.id" }, "quantity": { "add": [1, 2] } } }, "context": { "state": { "id": "card" } }, "expected": { "id": "card", "quantity": 3 } },
    { "name": "object rejects reserved keys", "expression": { "object": { "read": 1 } }, "context": {}, "error": true },
    { "name": "object rejects empty field sets", "expression": { "object": {} }, "context": {}, "error": true }
  ],
  "templates": [
    { "name": "custom label", "template": "Continue {source.name}", "context": { "source": { "name": "Splinter Trail" } }, "expected": "Continue Splinter Trail" },
    { "name": "signed face", "template": "{source.name}: {die.face|signed}", "context": { "source": { "name": "Fortune" }, "die": { "face": 3 } }, "expected": "Fortune: +3" },
    { "name": "negative face", "template": "{die.face|signed}", "context": { "die": { "face": -3 } }, "expected": "-3" },
    { "name": "zero", "template": "{die.face|signed}", "context": { "die": { "face": 0 } }, "expected": "0" },
    { "name": "plural", "template": "{state.count} {state.count|plural:die:dice}", "context": { "state": { "count": 2 } }, "expected": "2 dice" },
    { "name": "singular", "template": "{state.count} {state.count|plural:die:dice}", "context": { "state": { "count": 1 } }, "expected": "1 die" },
    { "name": "literal braces", "template": "{{{source.name}}}", "context": { "source": { "name": "Example" } }, "expected": "{Example}" },
    { "name": "plain text, not markup evaluation", "template": "{source.name}", "context": { "source": { "name": "<b>Example</b>" } }, "expected": "<b>Example</b>" },
    { "name": "small decimal", "template": "{result.value|number}", "context": { "result": { "value": 0.0000001 } }, "expected": "0.0000001" },
    { "name": "missing value", "template": "{source.unknown}", "context": { "source": {} }, "error": true },
    { "name": "unsupported format", "template": "{source.name|html}", "context": {}, "error": true },
    { "name": "missing closing brace", "template": "{source.name", "context": {}, "error": true },
    { "name": "unmatched closing brace", "template": "Example }", "context": {}, "error": true },
    { "name": "object cannot become label", "template": "{state.roll}", "context": { "state": { "roll": {} } }, "error": true }
  ]
}
