{
  "rules": [
    {"id": "reroll-low", "bindings": [{"id": "result", "event": "roll.finished", "surface": "roll", "mode": "button"}], "ui": {"label": "Reroll dice below {actor.proficiency}", "report": "Rerolled to {result.total}"}, "do": [{"op": "roll.selectDice", "from": {"read": "event.roll"}, "where": {"and": [{"eq": [{"read": "die.role"}, "damage"]}, {"lt": [{"read": "die.face"}, {"read": "actor.proficiency"}]}]}, "as": "low"}, {"op": "roll.reroll", "from": {"read": "event.roll"}, "dice": {"read": "result.low"}, "choose": "new", "as": "edited"}, {"op": "value", "value": {"read": "result.edited.total"}, "as": "total"}, {"op": "roll.publish", "roll": {"read": "result.edited"}}]},
    {"id": "lucky", "bindings": [{"id": "result", "event": "roll.finished", "surface": "roll", "mode": "button"}], "ui": {"label": "Reroll one die, keep the higher"}, "do": [{"op": "roll.selectDice", "from": {"read": "event.roll"}, "where": {"eq": [{"read": "die.contributionId"}, "weapon"]}, "as": "dice"}, {"op": "roll.reroll", "from": {"read": "event.roll"}, "dice": {"read": "result.dice"}, "choose": "higher", "as": "edited"}, {"op": "roll.publish", "roll": {"read": "result.edited"}}]},
    {"id": "exacting", "bindings": [{"id": "result", "event": "roll.finished", "surface": "roll", "mode": "button"}], "ui": {"label": "Treat ones as maximum"}, "do": [{"op": "roll.selectDice", "from": {"read": "event.roll"}, "where": {"eq": [{"read": "die.face"}, 1]}, "as": "ones"}, {"op": "roll.setFaces", "from": {"read": "event.roll"}, "dice": {"read": "result.ones"}, "face": {"read": "die.sides"}, "as": "edited"}, {"op": "roll.publish", "roll": {"read": "result.edited"}}]},
    {"id": "brutal", "bindings": [{"id": "result", "event": "roll.finished", "surface": "roll", "mode": "button"}], "ui": {"label": "Explode maximum dice"}, "do": [{"op": "roll.selectDice", "from": {"read": "event.roll"}, "where": {"eq": [{"read": "die.role"}, "damage"]}, "as": "dice"}, {"op": "roll.explode", "from": {"read": "event.roll"}, "dice": {"read": "result.dice"}, "when": {"eq": [{"read": "die.face"}, {"read": "die.sides"}]}, "maxDice": 2, "as": "edited"}, {"op": "roll.publish", "roll": {"read": "result.edited"}}]},
    {"id": "smite", "bindings": [{"id": "result", "event": "roll.finished", "surface": "roll", "mode": "button"}], "ui": {"label": "Add radiant damage"}, "do": [{"op": "roll.contribute", "from": {"read": "event.roll"}, "contribution": {"id": "smite", "kind": "dice", "role": "damage", "label": "{source.name}", "count": 1, "sides": 6, "editable": false}, "as": "withDice"}, {"op": "roll.contribute", "from": {"read": "result.withDice"}, "contribution": {"id": "smite-flat", "kind": "flat", "role": "damage", "label": "{source.name} bonus", "value": {"read": "actor.proficiency"}}, "as": "edited"}, {"op": "roll.publish", "roll": {"read": "result.edited"}}]},
    {"id": "flat-preview", "bindings": [{"id": "result", "event": "roll.finished", "surface": "roll", "mode": "button"}], "ui": {"label": "Add a flat bonus", "preview": "New total {result.edited.total}"}, "do": [{"op": "roll.contribute", "from": {"read": "event.roll"}, "contribution": {"id": "bonus", "kind": "flat", "role": "damage", "label": "Bonus", "value": 2}, "as": "edited"}]}
  ]
}
