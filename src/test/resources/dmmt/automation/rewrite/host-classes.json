{
  "format": "dmmap-daggerheart",
  "version": 2,
  "category": "classes",
  "label": "Host integration fixture, not the live catalog",
  "entries": [
    {
      "id": "tester",
      "name": "Tester",
      "features": [
        {
          "id": "rally",
          "name": "Rally",
          "automation": {
            "limits": { "once": { "max": 1, "resetOn": ["rest.short"] } },
            "rules": [{
              "id": "rally",
              "bindings": [{ "id": "sheet", "event": "action.request", "surface": "sheet", "mode": "button", "audience": "party" }],
              "limitRef": "once",
              "do": [
                { "op": "resource.gain", "pool": "actor.hope", "amount": 2, "as": "gained" },
                { "op": "countdown.start", "label": "Rally from {actor.name}", "value": 3 }
              ],
              "ui": { "label": "Rally ({actor.hope.value} Hope)", "report": "{actor.name} rallied for {result.gained} Hope." }
            }]
          }
        },
        {
          "id": "forage",
          "name": "Forage",
          "automation": {
            "rules": [{
              "id": "forage",
              "bindings": [{ "id": "sheet", "event": "action.request", "surface": "sheet", "mode": "button" }],
              "costs": [{ "op": "track.mark", "track": "actor.stress", "amount": 1 }],
              "do": [
                { "op": "collection.add", "target": "actor", "collection": "inventory",
                  "item": { "object": { "id": "berries", "label": "Berries", "quantity": 2 } }, "as": "item" },
                { "op": "track.capacity", "track": "actor.hp", "by": 1 }
              ],
              "ui": { "label": "Forage", "report": "Found {result.item.quantity} {result.item.label}." }
            }]
          }
        },
        {
          "id": "steady",
          "name": "Steady",
          "automation": {
            "rules": [{
              "id": "steady",
              "bindings": [{ "id": "auto", "event": "action.request", "surface": "sheet", "mode": "automatic" }],
              "when": { "gt": [{ "read": "actor.stress.marked" }, 0] },
              "do": [{ "op": "resource.gain", "pool": "actor.hope", "amount": 1 }],
              "ui": { "label": "Steady", "report": "Steady." }
            }]
          }
        }
      ]
    }
  ]
}
