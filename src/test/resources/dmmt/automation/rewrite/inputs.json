{
  "rules": [
    {
      "id": "inspire",
      "bindings": [{ "id": "sheet", "event": "action.request", "surface": "sheet", "mode": "button" }],
      "ui": { "label": "Inspire an ally", "report": "Inspired {result.target}" },
      "inputs": [{ "id": "ally", "kind": "choice", "label": "Ally", "optionsFrom": { "read": "actor.allies" } }],
      "do": [{ "op": "value", "value": { "read": "input.ally" }, "as": "target" }]
    },
    {
      "id": "split",
      "bindings": [{ "id": "sheet", "event": "action.request", "surface": "sheet", "mode": "button" }],
      "ui": { "label": "Split {actor.proficiency} points", "report": "{input.split.armor}/{input.split.hope}/{input.split.stress}" },
      "inputs": [{ "id": "split", "kind": "allocation", "label": "Distribute", "total": { "read": "actor.proficiency" }, "max": 2,
        "options": [
          { "id": "armor", "label": "Armor" },
          { "id": "hope", "label": "Hope" },
          { "id": "stress", "label": "Stress", "when": { "gt": [{ "read": "actor.stress" }, 0] } }
        ] }],
      "do": [{ "op": "value", "value": { "read": "input.split.armor" }, "as": "armor" }]
    }
  ]
}
