{
  "pools": {
    "favor": { "kind": "number", "scope": "actor", "label": "Favor", "max": 5, "initial": 0 }
  },
  "limits": {
    "uses": { "max": 1, "resetOn": ["rest.long"] }
  },
  "rules": [
    {
      "id": "rally",
      "bindings": [{
        "id": "sheet",
        "event": "action.request",
        "surface": "sheet",
        "mode": "button",
        "targetSelection": {
          "cardinality": "all",
          "scope": "connectedPlayerCharacters",
          "excludeSource": true
        }
      }],
      "costs": [{ "op": "resource.spend", "pool": "actor.hope", "amount": 1 }],
      "limitRef": "uses",
      "do": [
        { "op": "track.clear", "track": "recipient.stress", "amount": 1, "as": "cleared" },
        { "op": "pool.gain", "pool": "favor", "amount": 1, "owner": "recipient", "as": "favor" }
      ],
      "ui": { "label": "Rally", "report": "{recipient.name} cleared {result.cleared} Stress and gained {result.favor} Favor." }
    }
  ]
}
