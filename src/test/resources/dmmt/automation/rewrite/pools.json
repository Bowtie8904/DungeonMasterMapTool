{
  "pools": {
    "prayer-dice": {
      "kind": "dice",
      "scope": "source",
      "max": 3,
      "resetOn": ["session.start"]
    },
    "warlock-favor": {
      "kind": "number",
      "scope": "actor",
      "max": 6,
      "initial": 1,
      "resetOn": ["rest.long"]
    }
  },
  "rules": [
    {
      "id": "gather",
      "bindings": [{ "id": "sheet", "event": "action.request", "surface": "sheet", "mode": "button" }],
      "do": [{
        "op": "pool.roll",
        "pool": "prayer-dice",
        "count": { "add": [2, { "read": "actor.extraDice" }] },
        "sides": 6,
        "keepHighest": 2,
        "as": "draw"
      }],
      "ui": { "label": "Gather {source.name}'s dice" }
    },
    {
      "id": "spend-die",
      "bindings": [{
        "id": "per-die",
        "event": "action.request",
        "surface": "sheet",
        "mode": "button",
        "forEach": "prayer-dice",
        "when": { "gte": [{ "read": "die.face" }, 1] }
      }],
      "do": [
        { "op": "track.clear", "track": "actor.stress", "amount": { "read": "die.face" }, "as": "cleared" },
        { "op": "pool.removeDie", "pool": "prayer-dice", "dieId": { "read": "die.id" }, "as": "spent" }
      ],
      "ui": {
        "label": "Spend d{die.sides} showing {die.face}",
        "report": "Spent d{result.spent.sides} showing {result.spent.face}; cleared {result.cleared} Stress."
      }
    },
    {
      "id": "aid-roll",
      "bindings": [{
        "id": "roll-result",
        "event": "roll.finished",
        "surface": "chat",
        "mode": "button",
        "forEach": "prayer-dice",
        "group": "otherFeatures"
      }],
      "do": [
        {
          "op": "roll.addPoolDie",
          "pool": "prayer-dice",
          "dieId": { "read": "die.id" },
          "from": { "read": "event.roll" },
          "role": "aid",
          "label": "Aid from {source.name}: d{die.sides} showing {die.face}",
          "as": "aided"
        },
        { "op": "roll.publish", "roll": { "read": "result.aided" } }
      ],
      "ui": {
        "label": "Aid with d{die.sides} showing {die.face}",
        "report": "Added an aid die; the derived roll is {result.aided.total}."
      }
    },
    {
      "id": "reduce-damage",
      "bindings": [{
        "id": "incoming",
        "event": "damage.prepare",
        "surface": "damage",
        "mode": "button",
        "forEach": "prayer-dice",
        "group": "otherFeatures"
      }],
      "when": { "gt": [{ "read": "event.damage.amount" }, 0] },
      "do": [
        {
          "op": "damage.reduce",
          "from": { "read": "event.damage" },
          "amount": { "read": "die.face" },
          "id": "prayer-{die.id}",
          "label": "{source.name} die d{die.sides}",
          "as": "reduction"
        },
        {
          "op": "pool.removeDie",
          "pool": "prayer-dice",
          "dieId": { "read": "die.id" },
          "as": "spent"
        }
      ],
      "ui": {
        "label": "Reduce damage by {die.face}",
        "report": "{source.name} reduced damage by {result.reduction.adjustment.applied}."
      }
    },
    {
      "id": "fixed-ward",
      "bindings": [{
        "id": "incoming",
        "event": "damage.prepare",
        "surface": "damage",
        "mode": "button"
      }],
      "when": { "gt": [{ "read": "event.damage.amount" }, 0] },
      "costs": [
        { "op": "resource.spend", "pool": "actor.hope", "amount": 1 }
      ],
      "do": [
        {
          "op": "damage.reduce",
          "from": { "read": "event.damage" },
          "amount": 3,
          "id": "ward-{source.instanceId}",
          "label": "{source.name}",
          "as": "reduction"
        }
      ],
      "ui": {
        "label": "Use {source.name}",
        "report": "{source.name} reduced damage by {result.reduction.adjustment.applied}."
      }
    },
    {
      "id": "resolve-damage",
      "bindings": [{
        "id": "apply",
        "event": "damage.prepare",
        "surface": "damage",
        "mode": "button"
      }],
      "when": { "gt": [{ "read": "event.damage.amount" }, 0] },
      "inputs": [{
        "id": "armorSlots",
        "kind": "integer",
        "min": 0,
        "max": { "subtract": [{ "read": "actor.armorTrack.slots" }, { "read": "actor.armorTrack.on" }] },
        "label": "Armor slots to mark"
      }],
      "do": [{
        "op": "damage.resolve",
        "from": { "read": "event.damage" },
        "thresholds": { "majorAt": 5, "severeAt": 9 },
        "armor": {
          "track": "actor.armorTrack",
          "marked": "on",
          "capacity": "slots",
          "spend": { "read": "input.armorSlots" },
          "severitySteps": 1
        },
        "hitPoints": {
          "track": "actor.hp",
          "marked": "on",
          "capacity": "slots",
          "minor": 1,
          "major": 2,
          "severe": 3
        },
        "as": "resolution"
      }],
      "ui": {
        "label": "Resolve incoming damage",
        "report": "Damage became {result.resolution.severity}; marked {result.resolution.hitPoints.applied} HP."
      }
    },
    {
      "id": "gain-favor",
      "bindings": [{ "id": "sheet", "event": "action.request", "surface": "sheet", "mode": "button" }],
      "do": [{ "op": "pool.gain", "pool": "warlock-favor", "amount": 2, "as": "gained" }],
      "ui": { "label": "Gain Favor", "report": "Gained {result.gained} Favor." }
    },
    {
      "id": "spend-favor",
      "bindings": [{ "id": "sheet", "event": "action.request", "surface": "sheet", "mode": "button" }],
      "costs": [{ "op": "pool.spend", "pool": "warlock-favor", "amount": 2, "as": "spent" }],
      "do": [{ "op": "value", "value": { "read": "result.spent" }, "as": "paid" }],
      "ui": { "label": "Spend Favor", "report": "Spent {result.paid} Favor." }
    }
  ]
}
