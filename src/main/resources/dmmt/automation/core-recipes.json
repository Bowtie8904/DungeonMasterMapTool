{
  "format": "dmmap-daggerheart-rules",
  "version": 2,
  "recipes": [
    {
      "id": "core:repeat-saved-weapon-damage",
      "args": {
        "startCosts": { "type": "costs" },
        "firstProficiencyBonus": { "type": "integer", "min": 0, "max": 10 },
        "removeEachTime": { "type": "integer", "min": 1, "max": 20 },
        "dieRole": { "type": "string", "default": "weaponBase" },
        "minDiceLeftToDealDamage": { "type": "integer", "min": 1, "max": 20, "default": 1 }
      },
      "ui": {
        "start": "{source.name}",
        "damage": "{source.name} damage",
        "continue": "Continue {source.name}",
        "end": "End {source.name}",
        "chooseDice": "Choose a weapon die to remove",
        "dieChoice": "d{die.sides}: {die.face}",
        "startReport": "{actor.name} started {source.name}.",
        "damageReport": "{source.name}: {result.damage.total} damage.",
        "preview": "Remaining damage: {result.damage.total}. No new dice are rolled.",
        "continueReport": "{source.name}: {result.damage.total} damage; {state.uses} damage rolls used.",
        "endReport": "{actor.name} ended {source.name}.",
        "exhaustReport": "{source.name} has no further damage rolls remaining."
      },
      "rules": [
        {
          "id": "start",
          "bindings": [
            { "id": "sheet", "event": "action.request", "surface": "sheet", "mode": "button" },
            { "id": "attack", "event": "roll.prepare", "surface": "roll", "mode": "option", "when": { "eq": [{ "read": "event.role" }, "weaponAttack"] } }
          ],
          "when": { "eq": [{ "read": "state.phase" }, "inactive"] },
          "costs": { "$arg": "startCosts" },
          "do": [
            { "op": "state.set", "slot": "phase", "value": "ready" },
            { "op": "state.increment", "slot": "activation", "by": 1 },
            { "op": "state.set", "slot": "uses", "value": 0 },
            { "op": "state.set", "slot": "firstDamage", "value": null },
            { "op": "state.set", "slot": "weaponId", "value": null },
            { "op": "state.set", "slot": "originalEligibleDice", "value": { "literal": [] } },
            { "op": "state.set", "slot": "remainingDice", "value": { "literal": [] } }
          ],
          "ui": { "label": { "$ui": "start" }, "report": { "$ui": "startReport" } }
        },
        {
          "id": "first",
          "bindings": [
            { "id": "damage", "event": "roll.prepare", "surface": "roll", "mode": "option", "defaultOn": true,
              "when": { "eq": [{ "read": "event.role" }, "weaponDamage"] } }
          ],
          "when": { "eq": [{ "read": "state.phase" }, "ready"] },
          "do": [
            { "op": "value", "value": { "add": [{ "read": "actor.proficiency" }, { "read": "args.firstProficiencyBonus" }] }, "as": "effectiveProficiency" },
            { "op": "roll.resolve", "plan": { "read": "event.damagePlan" }, "as": "damage" },
            { "op": "roll.keptDice", "from": { "read": "result.damage" }, "role": { "$arg": "dieRole" }, "as": "eligible" },
            { "op": "state.set", "slot": "phase", "value": "continuing" },
            { "op": "state.set", "slot": "firstDamage", "value": { "read": "result.damage" } },
            { "op": "state.set", "slot": "weaponId", "value": { "read": "event.weaponId" } },
            { "op": "state.set", "slot": "originalEligibleDice", "value": { "read": "result.eligible" } },
            { "op": "state.set", "slot": "remainingDice", "value": { "read": "result.eligible" } },
            { "op": "state.set", "slot": "uses", "value": 1 },
            { "op": "roll.publish", "roll": { "read": "result.damage" } }
          ],
          "ui": { "label": { "$ui": "damage" }, "report": { "$ui": "damageReport" } }
        },
        {
          "id": "continue",
          "bindings": [
            {
              "id": "result", "event": "roll.finished", "surface": "chat", "mode": "button", "group": "result",
              "when": { "and": [
                { "eq": [{ "read": "event.sourceInstanceId" }, { "read": "source.instanceId" }] },
                { "eq": [{ "read": "event.activation" }, { "read": "state.activation" }] },
                { "eq": [{ "read": "event.sequenceStep" }, { "read": "state.uses" }] }
              ] }
            },
            {
              "id": "damage", "event": "roll.prepare", "surface": "roll", "mode": "option", "defaultOn": true,
              "when": { "and": [
                { "eq": [{ "read": "event.role" }, "weaponDamage"] },
                { "eq": [{ "read": "event.weaponId" }, { "read": "state.weaponId" }] }
              ] }
            }
          ],
          "when": { "and": [
            { "eq": [{ "read": "state.phase" }, "continuing"] },
            { "gte": [
              { "subtract": [{ "size": { "read": "state.remainingDice" } }, { "read": "args.removeEachTime" }] },
              { "read": "args.minDiceLeftToDealDamage" }
            ] }
          ] },
          "inputs": [{
            "id": "remove", "kind": "die.select", "from": { "read": "state.firstDamage" },
            "eligible": { "read": "state.remainingDice" }, "count": { "read": "args.removeEachTime" },
            "default": "lowest", "label": { "$ui": "chooseDice" }, "choiceLabel": { "$ui": "dieChoice" }
          }],
          "do": [
            { "op": "set.subtract", "from": { "read": "state.remainingDice" }, "items": { "read": "input.remove" }, "as": "kept" },
            { "op": "roll.derive", "from": { "read": "state.firstDamage" }, "keepSelectedWithin": { "read": "state.originalEligibleDice" }, "keep": { "read": "result.kept" }, "as": "damage" },
            { "op": "state.set", "slot": "remainingDice", "value": { "read": "result.kept" } },
            { "op": "state.increment", "slot": "uses", "by": 1 },
            { "op": "roll.publish", "roll": { "read": "result.damage" } }
          ],
          "ui": { "label": { "$ui": "continue" }, "preview": { "$ui": "preview" }, "report": { "$ui": "continueReport" } }
        },
        {
          "id": "exhaust",
          "bindings": [{
            "id": "damage", "event": "roll.prepare", "surface": "roll", "mode": "automatic",
            "when": { "eq": [{ "read": "event.role" }, "weaponDamage"] }
          }],
          "when": { "and": [
            { "eq": [{ "read": "state.phase" }, "continuing"] },
            { "lt": [
              { "subtract": [{ "size": { "read": "state.remainingDice" } }, { "read": "args.removeEachTime" }] },
              { "read": "args.minDiceLeftToDealDamage" }
            ] }
          ] },
          "do": [
            { "op": "state.set", "slot": "phase", "value": "inactive" },
            { "op": "state.set", "slot": "firstDamage", "value": null },
            { "op": "state.set", "slot": "remainingDice", "value": { "literal": [] } },
            { "op": "state.set", "slot": "originalEligibleDice", "value": { "literal": [] } }
          ],
          "ui": { "report": { "$ui": "exhaustReport" } }
        },
        {
          "id": "end",
          "bindings": [
            { "id": "effect", "event": "action.request", "surface": "effect", "mode": "button" },
            { "id": "result", "event": "roll.finished", "surface": "chat", "mode": "button", "group": "sourceFeature",
              "when": { "and": [
                { "eq": [{ "read": "event.sourceInstanceId" }, { "read": "source.instanceId" }] },
                { "eq": [{ "read": "event.activation" }, { "read": "state.activation" }] }
              ] } }
          ],
          "when": { "ne": [{ "read": "state.phase" }, "inactive"] },
          "do": [
            { "op": "state.set", "slot": "phase", "value": "inactive" },
            { "op": "state.set", "slot": "firstDamage", "value": null },
            { "op": "state.set", "slot": "remainingDice", "value": { "literal": [] } },
            { "op": "state.set", "slot": "originalEligibleDice", "value": { "literal": [] } }
          ],
          "ui": { "label": { "$ui": "end" }, "report": { "$ui": "endReport" } }
        }
      ]
    }
  ]
}
