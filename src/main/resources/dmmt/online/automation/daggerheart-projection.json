{
  "format": "dmmap-sheet-projection",
  "version": 2,
  "stateField": "automationState",
  "sourceField": "automationSource",
  "instanceField": "instanceId",
  "nameField": "name",
  "sources": [
    { "path": "features" },
    { "path": "heritage" },
    { "path": "loadout" },
    { "path": "inventory", "quantity": "qty" },
    { "path": "activeWeapons" },
    { "path": "activeArmor", "single": true }
  ],
  "actor": {
    "name": { "kind": "value", "path": "name" },
    "level": { "kind": "value", "path": "level" },
    "evasion": { "kind": "value", "path": "evasion" },
    "gold": { "kind": "value", "path": "gold", "writable": true, "min": 0, "max": 1000000 },
    "hp": { "kind": "object", "path": "hp", "fields": { "marked": "on", "capacity": "slots" },
            "writable": ["marked", "capacity"], "atLeast": { "total": "capacity" }, "max": 1000 },
    "stress": { "kind": "object", "path": "stress", "fields": { "marked": "on", "capacity": "slots" },
                "writable": ["marked", "capacity"], "atLeast": { "total": "capacity" }, "max": 1000 },
    "armorTrack": { "kind": "object", "path": "armorTrack", "fields": { "marked": "on", "capacity": "slots" },
                    "writable": ["marked", "capacity"], "atLeast": { "total": "capacity" }, "max": 1000 },
    "hope": { "kind": "object", "path": "hope", "fields": { "value": "on", "max": "slots" },
              "writable": ["value"], "max": 1000 },
    "proficiency": { "kind": "object", "path": "proficiency", "fields": { "value": "on" } },
    "armor": { "kind": "object", "path": "activeArmor", "fields": { "score": "score", "major": "major", "severe": "severe" } },
    "traits": { "kind": "map", "path": "traits", "key": "name", "value": "mod" },
    "spellcastTrait": { "kind": "first", "path": "traits", "where": { "field": "spellcast", "equals": true },
                        "fields": { "name": "name", "value": "mod" } },
    "inventory": { "kind": "collection", "path": "inventory",
                   "fields": { "id": "automationItem", "label": "name", "quantity": "qty", "grantedBy": "automationGrantedBy" },
                   "defaults": { "type": "loot", "qty": 1 } },
    "features": { "kind": "collection", "path": "features",
                  "fields": { "id": "automationItem", "label": "name", "text": "text", "grantedBy": "automationGrantedBy" },
                  "defaults": { "source": "Automation", "text": "" } },
    "loadout": { "kind": "collection", "path": "loadout", "fields": { "id": "name", "domain": "domain" }, "writable": false },
    "vault": { "kind": "collection", "path": "vault", "fields": { "id": "name", "domain": "domain" }, "writable": false },
    "heritage": { "kind": "collection", "path": "heritage", "fields": { "id": "name", "label": "name" }, "writable": false },
    "pools": { "kind": "engine", "path": "automationState.pools", "default": {} },
    "effects": { "kind": "engine", "path": "automationState.effects", "default": [] },
    "conditions": { "kind": "engine", "path": "automationState.conditions", "default": [] },
    "companions": { "kind": "engine", "path": "automationState.companions", "default": [] }
  },
  "stats": [
    { "id": "level", "value": { "if": [{ "exists": "actor.level" }, { "read": "actor.level" }, 1] } },
    { "id": "tier", "value": { "if": [{ "gte": [{ "read": "actor.stats.level" }, 8] }, 4,
        { "if": [{ "gte": [{ "read": "actor.stats.level" }, 5] }, 3,
          { "if": [{ "gte": [{ "read": "actor.stats.level" }, 2] }, 2, 1] }] }] } },
    { "id": "trait.Agility", "value": { "if": [{ "exists": "actor.traits.Agility" }, { "read": "actor.traits.Agility" }, 0] } },
    { "id": "trait.Strength", "value": { "if": [{ "exists": "actor.traits.Strength" }, { "read": "actor.traits.Strength" }, 0] } },
    { "id": "trait.Finesse", "value": { "if": [{ "exists": "actor.traits.Finesse" }, { "read": "actor.traits.Finesse" }, 0] } },
    { "id": "trait.Instinct", "value": { "if": [{ "exists": "actor.traits.Instinct" }, { "read": "actor.traits.Instinct" }, 0] } },
    { "id": "trait.Presence", "value": { "if": [{ "exists": "actor.traits.Presence" }, { "read": "actor.traits.Presence" }, 0] } },
    { "id": "trait.Knowledge", "value": { "if": [{ "exists": "actor.traits.Knowledge" }, { "read": "actor.traits.Knowledge" }, 0] } },
    { "id": "spellcast.base", "value": { "if": [{ "exists": "actor.spellcastTrait.value" }, { "read": "actor.spellcastTrait.value" }, 0] } },
    { "id": "spellcast.total", "value": { "if": [{ "not": { "exists": "actor.spellcastTrait.name" } }, 0,
        { "if": [{ "eq": [{ "read": "actor.spellcastTrait.name" }, "Agility"] }, { "read": "actor.stats.trait.Agility" },
        { "if": [{ "eq": [{ "read": "actor.spellcastTrait.name" }, "Strength"] }, { "read": "actor.stats.trait.Strength" },
        { "if": [{ "eq": [{ "read": "actor.spellcastTrait.name" }, "Finesse"] }, { "read": "actor.stats.trait.Finesse" },
        { "if": [{ "eq": [{ "read": "actor.spellcastTrait.name" }, "Instinct"] }, { "read": "actor.stats.trait.Instinct" },
        { "if": [{ "eq": [{ "read": "actor.spellcastTrait.name" }, "Presence"] }, { "read": "actor.stats.trait.Presence" },
        { "if": [{ "eq": [{ "read": "actor.spellcastTrait.name" }, "Knowledge"] }, { "read": "actor.stats.trait.Knowledge" }, 0] }] }] }] }] }] }] } },
    { "id": "proficiency", "value": { "if": [{ "exists": "actor.proficiency.value" }, { "read": "actor.proficiency.value" }, 1] }, "min": 1 },
    { "id": "evasion", "value": { "if": [{ "exists": "actor.evasion" }, { "read": "actor.evasion" }, 0] } },
    { "id": "armorScore", "value": { "if": [{ "exists": "actor.armor.score" }, { "read": "actor.armor.score" }, 0] }, "min": 0 },
    { "id": "armorAvailable", "value": { "if": [{ "exists": "actor.armorTrack.capacity" },
        { "max": [0, { "subtract": [{ "read": "actor.armorTrack.capacity" },
          { "if": [{ "exists": "actor.armorTrack.marked" }, { "read": "actor.armorTrack.marked" }, 0] }] }] }, 0] } },
    { "id": "thresholds.major", "min": 0, "value": { "add": [{ "read": "actor.stats.level" },
        { "if": [{ "exists": "actor.armor.major" }, { "read": "actor.armor.major" },
          { "if": [{ "exists": "actor.armor.score" }, { "add": [{ "read": "actor.armor.score" }, 4] }, 0] }] }] } },
    { "id": "thresholds.severe", "min": 0, "value": { "add": [{ "read": "actor.stats.level" },
        { "if": [{ "exists": "actor.armor.severe" }, { "read": "actor.armor.severe" },
          { "if": [{ "exists": "actor.armor.score" }, { "add": [{ "multiply": [{ "read": "actor.armor.score" }, 2] }, 7] },
            { "read": "actor.stats.level" }] }] }] } },
    { "id": "loadout.max", "value": 5, "min": 0 }
  ]
}
